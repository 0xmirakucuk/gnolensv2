# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (docker-compose defaults) ---
DATABASE_URL="postgresql://bemacs:bemacs@localhost:5432/bemacs"
# Used by integration + e2e tests; wiped and re-seeded by the test setup.
TEST_DATABASE_URL="postgresql://bemacs:bemacs@localhost:5432/bemacs_test"

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the app, no trailing slash.
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated. These addresses may sign in even outside @studbocconi.it and get the ADMIN role.
ADMIN_EMAILS=""

# --- Email ---
EMAIL_FROM="BEMACS Exam Prep <no-reply@localhost>"
# Production: set RESEND_API_KEY and Resend is used; SMTP settings are then ignored.
RESEND_API_KEY=""
# Development/CI: Mailpit from docker-compose.
SMTP_HOST="localhost"
SMTP_PORT="1025"
# Mailpit web UI/API, used by e2e tests to read magic links.
MAILPIT_URL="http://localhost:8025"
